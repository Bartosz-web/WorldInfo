<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CountryInfoApp.Wpf.Converters">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D9DEE3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F6FB2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6670" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#A12622" />
    <SolidColorBrush x:Key="CorrectBrush" Color="#D7F2DC" />
    <SolidColorBrush x:Key="WrongBrush" Color="#F8D7DA" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,4,12,4" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="90" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <!-- Busy indicator and error banner shared by all views. -->
    <DataTemplate x:Key="StatusTemplate">
        <StackPanel>
            <ProgressBar Height="4" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource ErrorBackgroundBrush}" CornerRadius="4" Padding="10,6" Margin="6,4"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Spróbuj ponownie" Command="{Binding RetryCommand}"
                            Visibility="{Binding RetryCommand, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorTextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Horizontal bar used by the statistics view. -->
    <DataTemplate x:Key="BarTemplate">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Height="16" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Count}"
                         Foreground="{StaticResource AccentBrush}" />
            <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
