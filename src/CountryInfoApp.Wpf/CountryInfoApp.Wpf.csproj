<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows building (not running) the WPF project on non-Windows machines, e.g. in CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CountryInfoApp</AssemblyName>
    <RootNamespace>CountryInfoApp.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CountryInfoApp.Core\CountryInfoApp.Core.csproj" />
    <ProjectReference Include="..\CountryInfoApp.Infrastructure\CountryInfoApp.Infrastructure.csproj" />
    <ProjectReference Include="..\CountryInfoApp.Presentation\CountryInfoApp.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
