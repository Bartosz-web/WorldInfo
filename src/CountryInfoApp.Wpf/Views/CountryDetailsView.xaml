<UserControl x:Class="CountryInfoApp.Wpf.Views.CountryDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" />

        <TextBlock DockPanel.Dock="Top" Text="Wybierz kraj z listy, aby zobaczyć szczegóły."
                   Foreground="{StaticResource MutedTextBrush}" Margin="4">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCountry}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasCountry, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Image Source="{Binding Country.FlagUrl, TargetNullValue={x:Null}}" Height="64" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Country.Name}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Country.IsoCode}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Stolica:" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Country.CapitalCity}" Style="{StaticResource FieldValue}" />

                    <TextBlock Grid.Row="1" Text="Kontynent:" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContinentName}" Style="{StaticResource FieldValue}" />

                    <TextBlock Grid.Row="2" Text="Numer kierunkowy:" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhoneCode}" Style="{StaticResource FieldValue}" />

                    <TextBlock Grid.Row="3" Text="Waluta:" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Currency}" Style="{StaticResource FieldValue}" />

                    <TextBlock Grid.Row="4" Text="Języki:" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Languages}" Style="{StaticResource FieldValue}" />
                </Grid>

                <TextBlock Text="Inne kraje używające tej waluty" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
                <ItemsControl ItemsSource="{Binding CountriesWithSameCurrency}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
