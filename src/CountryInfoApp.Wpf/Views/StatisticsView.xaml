<UserControl x:Class="CountryInfoApp.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" Margin="8,6" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="3" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Liczba krajów na kontynent" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding CountriesPerContinent}" ItemTemplate="{StaticResource BarTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Najpopularniejsze waluty" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding TopCurrencies}" ItemTemplate="{StaticResource BarTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Najpopularniejsze języki" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding TopLanguages}" ItemTemplate="{StaticResource BarTemplate}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
