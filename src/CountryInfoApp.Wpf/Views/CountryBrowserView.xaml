<UserControl x:Class="CountryInfoApp.Wpf.Views.CountryBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kontynenty" Style="{StaticResource SectionHeader}" />
                    <CheckBox DockPanel.Dock="Top" Content="Sortuj według kodu" Margin="0,0,0,8"
                              IsChecked="{Binding SortContinentsByCode}" />
                    <ListBox ItemsSource="{Binding Continents}" SelectedItem="{Binding SelectedContinent}"
                             DisplayMemberPath="DisplayName" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kraje" Style="{StaticResource SectionHeader}" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding CountryFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsoCode}" Width="32" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ContentControl Content="{Binding Details}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
